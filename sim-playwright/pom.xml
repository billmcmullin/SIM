<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sim.chatserver</groupId>
        <artifactId>chat-server-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>sim-playwright</artifactId>
    <packaging>jar</packaging>
    <name>sim-playwright</name>

    <properties>
        <maven.compiler.release>24</maven.compiler.release>

        <!--<junit.version>6.1.2</junit.version>-->
        <playwright.version>1.61.0</playwright.version>
        <failsafe.version>3.5.5</failsafe.version>
        <coverage.integration.version>1.0.0-SNAPSHOT</coverage.integration.version>

        <!-- Required for coverage-integration-junit5 to publish test lifecycle events -->
        <junit.jupiter.extensions.autodetection.enabled>true</junit.jupiter.extensions.autodetection.enabled>
        <parasoft.coverage.baggageHeader></parasoft.coverage.baggageHeader>

        <!-- UI test runtime defaults -->
        <baseUrl>http://localhost:8080/chat-server</baseUrl>
        <headless>true</headless>
        <ignoreHttpsErrors>true</ignoreHttpsErrors>

        <!-- Skip Playwright ITs in full reactor builds unless explicitly enabled -->
        <playwright.skipITs>true</playwright.skipITs>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.parasoft</groupId>
            <artifactId>coverage-integration-junit5</artifactId>
            <version>${coverage.integration.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.parasoft</groupId>
            <artifactId>coverage-integration-playwright</artifactId>
            <version>${coverage.integration.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Run Playwright integration tests only (app must already be running) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe.version}</version>
                <executions>
                    <execution>
                        <id>ui-it</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <skipITs>${playwright.skipITs}</skipITs>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                            <systemPropertyVariables>
                                <baseUrl>${baseUrl}</baseUrl>
                                <headless>${headless}</headless>
                                <ignoreHttpsErrors>${ignoreHttpsErrors}</ignoreHttpsErrors>
                                <junit.jupiter.extensions.autodetection.enabled>${junit.jupiter.extensions.autodetection.enabled}</junit.jupiter.extensions.autodetection.enabled>
                                <parasoft.coverage.baggageHeader>${parasoft.coverage.baggageHeader}</parasoft.coverage.baggageHeader>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>