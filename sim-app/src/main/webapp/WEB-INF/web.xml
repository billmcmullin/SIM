<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    version="6.0"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">

    <display-name>chat-server</display-name>

    <welcome-file-list>
        <welcome-file>login</welcome-file>
    </welcome-file-list>

    <session-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <servlet>
        <servlet-name>AdminConfigServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.AdminConfigServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminConfigServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WidgetApiServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.dashboard.widgets.WidgetApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WidgetApiServlet</servlet-name>
        <url-pattern>/admin/widgets</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SaveConfigServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.SaveConfigServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SaveConfigServlet</servlet-name>
        <url-pattern>/admin/save-config</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DatabaseBackupServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.DatabaseBackupServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DatabaseBackupServlet</servlet-name>
        <url-pattern>/admin/db/backup</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SalesforceOAuthStartServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.salesforce.SalesforceOAuthStartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesforceOAuthStartServlet</servlet-name>
        <url-pattern>/admin/salesforce/oauth/start</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SalesforceOAuthCallbackServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.salesforce.SalesforceOAuthCallbackServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesforceOAuthCallbackServlet</servlet-name>
        <url-pattern>/admin/salesforce/oauth/callback</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DatabaseImportServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.DatabaseImportServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DatabaseImportServlet</servlet-name>
        <url-pattern>/admin/db/import</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WidgetAvailabilityServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.WidgetAvailabilityServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WidgetAvailabilityServlet</servlet-name>
        <url-pattern>/admin/widget-availability.json</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>WidgetHealthConfigServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.WidgetHealthConfigServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>WidgetHealthConfigServlet</servlet-name>
        <url-pattern>/admin/widget-health-config</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminAutoEmailAlertsServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.AdminAutoEmailAlertsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAutoEmailAlertsServlet</servlet-name>
        <url-pattern>/admin/email/alerts</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TestAwsConnectionServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.TestAwsConnectionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TestAwsConnectionServlet</servlet-name>
        <url-pattern>/admin/test-aws-connection</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AwsEc2RestartServlet</servlet-name>
        <servlet-class>com.sim.chatserver.web.admin.AwsEc2RestartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AwsEc2RestartServlet</servlet-name>
        <url-pattern>/admin/aws/restart-ec2</url-pattern>
    </servlet-mapping>

</web-app>